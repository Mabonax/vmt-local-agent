{
  "version": "1.0.0",
  "runtime": "python3",
  "entrypoint": "runner.py",
  "protocol": "stdin-json-v1",
  "permissions": [],
  "network": false,
  "timeout_seconds": 5,
  "max_input_bytes": 1048576,
  "max_output_bytes": 1048576,
  "tools": [
    {
      "name": "math.calculate",
      "description": "Basic arithmetic",
      "input_schema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "add",
              "subtract",
              "multiply",
              "divide"
            ]
          },
          "a": {
            "type": "number"
          },
          "b": {
            "type": "number"
          }
        },
        "required": [
          "operation",
          "a",
          "b"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "data.describe",
      "description": "Descriptive statistics",
      "input_schema": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "values"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "text.inspect",
      "description": "Text counts",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 100000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "data.frequency",
      "description": "Frequency counts",
      "input_schema": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "required": [
          "values"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "data.json_validate",
      "description": "Strict JSON syntax and duplicate-key validation",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 100000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    }
  ]
}
