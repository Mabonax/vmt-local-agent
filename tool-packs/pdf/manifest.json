{
  "version": "1.0.0",
  "runtime": "python3",
  "entrypoint": "runner.py",
  "protocol": "stdin-json-v1",
  "permissions": [],
  "network": false,
  "timeout_seconds": 10,
  "max_input_bytes": 1048576,
  "max_output_bytes": 1048576,
  "tools": [
    {
      "name": "pdf.generate",
      "description": "Generate paginated PDF from Latin-1 text",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "body": {
            "type": "string",
            "maxLength": 30000
          }
        },
        "required": [
          "title",
          "body"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pdf.inspect",
      "description": "Inspect PDF page dimensions and rotation",
      "input_schema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 670000
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pdf.extract_text",
      "description": "Extract embedded text from selected pages",
      "input_schema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 670000
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "required": [
          "content",
          "pages"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pdf.split",
      "description": "Create PDF from selected pages",
      "input_schema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 670000
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "required": [
          "content",
          "pages"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pdf.merge",
      "description": "Combine PDF pages",
      "input_schema": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 670000
            }
          }
        },
        "required": [
          "documents"
        ],
        "additionalProperties": false
      }
    }
  ]
}
